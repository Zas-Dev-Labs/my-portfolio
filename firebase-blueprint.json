{
  "entities": {
    "projects": {
      "title": "Projects",
      "description": "Development and 3D printing projects displayed on the portfolio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["dev", "3d"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "image": { "type": "string" },
        "isActive": { "type": "boolean", "default": true },
        "startedOn": { "type": "string", "format": "date" },
        "showFrom": { "type": "string", "format": "date" },
        "showTo": { "type": "string", "format": "date", "nullable": true },
        "privacyPolicyLink": { "type": "string" },
        "externalLink": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "description", "type", "tags", "status", "image"]
    },
    "invoices": {
      "title": "Invoices",
      "description": "ZasDevLabs invoices generated by the admin tool",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["draft", "pending", "paid", "overdue", "cancelled"] },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "accentColor": { "type": "string" },
        "sender": { "type": "object" },
        "client": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "totalTax": { "type": "number" },
        "total": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "date", "dueDate", "sender", "client", "items", "total"]
    },
    "clients": {
      "title": "Clients",
      "description": "Saved client directory records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "vatOrTaxNumber": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  }
}
